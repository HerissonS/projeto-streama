# ==============================================================================
# PROJETO STREAMA - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ==============================================================================
# Copie este arquivo para .env antes de executar os serviços:
# cp .env.example .env
#
# IMPORTANTE: Altere todas as senhas default para senhas fortes em produção/testes!
# ==============================================================================

# --- OPENLDAP CONFIGURATIONS ---
LDAP_ORGANISATION=g2cloud
LDAP_DOMAIN=g2cloud.com
LDAP_BASE_DN=dc=g2cloud,dc=com
LDAP_ADMIN_USERNAME=admin
LDAP_ADMIN_PASSWORD=SUA_SENHA_ADMIN_LDAP_AQUI
LDAP_CONFIG_PASSWORD=SUA_SENHA_CONFIG_LDAP_AQUI
LDAP_READONLY_USER=true
LDAP_READONLY_USER_USERNAME=user-ro
LDAP_READONLY_USER_PASSWORD=SUA_SENHA_READONLY_LDAP_AQUI

# --- PHPLDAPADMIN CONFIGURATIONS ---
PHPLDAPADMIN_PORT=8096

# --- MARIADB / DATABASE CONFIGURATIONS ---
DB_HOST=seu_endpoint_rds_ou_ip_mariadb
DB_NAME=bd_ct_foco
DB_USER=mariadbmaster
DB_PASSWORD=SUA_SENHA_BANCO_DE_DADOS_AQUI
DB_PORT=3306

# --- APPLICATION PORTS ---
SIGNUP_PORT=80
STREAMA_PORT=8080
